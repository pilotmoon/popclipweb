{
  "type": "module",
  "scripts": {
    "docs:dev": "./makeEnv && source .env && vitepress dev site",
    "docs:dev-local": "./makeEnv && source .env && PILOTMOON_API_ROOT=http://localhost:1234 PILOTMOON_PUBLIC_ROOT=https://public.popclip.app/test PILOTMOON_API_KEY=${PILOTMOON_LOCAL_API_KEY:-$PILOTMOON_API_KEY} vitepress dev site",
    "docs:preview": "./makeEnv && source .env && vitepress preview site",
    "docs:build": "npm run check && ./makeEnv && source .env && npm run docs:build-ci",
    "docs:build-ci": "npx patch-package && vitepress build site",
    "check": "tsc --noEmit",
    "format:md": "prettier --write \"**/*.md\"",
    "types:link": "npm --prefix ../popclip-types run build && npm install --no-save ../popclip-types && readlink node_modules/@popclip/types",
    "types:unlink": "npm install && npm ls @popclip/types"
  },
  "dependencies": {
    "@ant-design/icons-vue": "6.1.0",
    "@biomejs/biome": "1.8.2",
    "@mdit/plugin-img-size": "0.4.8",
    "@pilotmoon/chewit": "0.3.0",
    "@popclip/types": "2.6159.0",
    "@tabler/icons-vue": "3.5.0",
    "@vicons/fa": "0.12.0",
    "@vicons/fluent": "0.12.0",
    "@vicons/utils": "0.1.4",
    "@vueuse/core": "10.9.0",
    "axios": "1.8.2",
    "canvas-confetti": "1.9.3",
    "element-plus": "2.8.8",
    "js-sha256": "0.11.0",
    "js-yaml": "4.1.0",
    "lru-cache": "10.2.1",
    "markdown-it-html5-media": "0.7.1",
    "markdown-it-image-figures": "2.1.1",
    "p-limit": "5.0.0",
    "patch-package": "8.0.0",
    "sanitize-html": "2.13.1",
    "typedoc": "0.28.20",
    "typescript": "6.0.3",
    "unplugin-element-plus": "0.8.0",
    "vitepress": "1.6.4",
    "vue": "3.5.13",
    "vue3-simple-icons": "9.10.0",
    "vue3-spinners": "1.2.2",
    "zod": "3.23.8"
  },
  "devDependencies": {
    "@types/canvas-confetti": "1.9.0",
    "@types/js-yaml": "4.0.9",
    "@types/node": "20.4.7",
    "prettier": "3.8.1"
  }
}
